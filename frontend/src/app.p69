@font-face {
	font-family: 'Nunito';
	src: url('/fonts/nunito/Nunito-VariableFont_wght.ttf') format('truetype');
}

:root {
	$variables.base("	");
}

:root {
	$variables.light("	");
}

@media (prefers-color-scheme: dark) {
	:root {
		$variables.dark("		");
	}
}

*,
::before,
::after {
	box-sizing: border-box;
	border: 0 solid transparent;
}

body {
	padding: 0;
	margin: 0;

	background-color: var(--theme-bg);

	color: var(--theme-text);
	font-size: var(--font-size-md);
	font-family: var(--font-family-nunito);

	text-size-adjust: 100%;
	tab-size: 2;
}

main {
	padding: var(--indent-1);
}

h1, h2, h3, h4, h5, h6 {
	margin-top: 0;
}

h2 {
	margin-top: var(--space-md);
	color: var(--theme-strong);
}

p, blockquote {
	margin-left: var(--indent-1);
	margin-bottom: var(--space-sm);
}

blockquote {
	font-style: italic;
	margin-left: var(--indent-1);
}

a {
	color: var(--theme-link);

	&:hover {
		color: var(--theme-link);
	}
}

strong {
	color: var(--theme-strong);
}

button {
	margin: 0;
	width: fit-content;

	padding: var(--space-xxs) var(--space-sm);

	border-radius: 4px;

	text-align: center;
	cursor: pointer;

	color: var(--theme-text);
	font-size: var(--font-size-md);

	background: var(--theme-bg);
	border: 2px solid var(--theme-border);

	&:hover {
		color: var(--theme-text);
		background: var(--theme-bg);
	}
}

input {
	border: 1px solid var(--theme-border);
	border-radius: 4px;
	width: min(100%, 32ch);
	height: 2em;
	padding: 0 var(--space-xs);
	font-size: var(--font-size-md);
}

dl.not-bold dt {
	font-weight: normal;
}

dt {
	font-weight: bold;
	margin-top: var(--space-xxs);
	margin-left: var(--indent-1);
}

dd {
	min-height: 1.4em;
	margin-bottom: var(--space-xxs);
	margin-left: var(--indent-2);
}

ul, ol {
	padding-left: var(--indent-2);
}

dd > ul {
	padding-left: var(--indent-1);
}

li {
	margin-top: var(--space-xxs);
}

/* 
	Experimental

	Read up custom elements: https://developer.mozilla.org/en-US/docs/Web/API/Web_components/Using_custom_elements
*/
indent {
	display: block;
	padding-left: var(--indent-1);
}

todo {
	position: relative;
	display: block;
	font-weight: bold;
	font-style: italic;
	margin-bottom: var(--space-sm);
	padding-left: 8ch;
	min-height: 1em;

	&:before {
		position: absolute;
		top: 0;
		left: 0;
		content: 'TODO';
		color: var(--theme-strong);
		margin-left: var(--indent-1);
		margin-right: var(--indent-1);
	}
}

strapline {
	display: block;
	font-size: var(--font-size-md);
	color: var(--theme-strong);
}
